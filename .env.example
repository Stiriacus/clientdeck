# ── Required ──────────────────────────────────────────────────
# Shared secret that n8n/webhook callers must send in the
# X-Webhook-Secret header. Must be ≥ 32 characters.
VITRINE_WEBHOOK_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Public base URL used to construct board links in responses.
VITRINE_BASE_URL=https://boards.example.com

# ── Optional ──────────────────────────────────────────────────
# Listen address (default: ":8080")
# VITRINE_ADDR=:8080

# SQLite database path (default: "./vitrine.db")
# Inside Docker, map a volume to /data and use /data/vitrine.db
# VITRINE_DB_PATH=/data/vitrine.db

# Theme name — "plain" is built into the binary. This also sets the
# fallback theme used when a customer has no theme assigned or when
# their configured theme is not found.
# VITRINE_THEME=plain

# Directory containing additional theme subdirectories (optional).
# Each subdirectory must have layout.html, board.html, notfound.html,
# i18n/, and optionally static/. Themes here are loaded once at
# startup and can be assigned per-customer via the webhook payload.
# Set VITRINE_THEMES_DIR=/themes in Docker, or omit to use only
# the embedded "plain" theme.
# VITRINE_THEMES_DIR=

# Log level: debug | info | warn | error (default: "info")
# VITRINE_LOG_LEVEL=info

# ── Development Only ──────────────────────────────────────────
# Enable dev mode: reloads templates from disk on every request.
# Only needed when actively developing theme templates (hot-reload).
# Do NOT use in production.
# VITRINE_DEV=false

# Path to a JSON payload for the /c/demo route (requires DEV=true).
# VITRINE_DEMO_PAYLOAD=testdata/example_payload.json
